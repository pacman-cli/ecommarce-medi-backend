# ==============================================================================
# E-Commerce Backend Docker Environment Variable Configuration Template
# Copy this file to .env and customize values for production deployment
# ==============================================================================

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Configuration
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommercesecurepassword2026!
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redissecurepassword2026!

# MinIO Object Storage Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecurepassword2026!
MINIO_BUCKET_NAME=ecommerce-uploads

# Security & JWT Token Config (Minimum 64 characters for HMAC-SHA512)
JWT_SECRET=super-secret-jwt-signing-key-for-production-ecommerce-backend-auth-token-2026!

# CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
